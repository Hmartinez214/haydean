# Copy to cluster.env and fill in for your cluster. cluster.env is gitignored.

# Address of the node running beegfs-mgmtd. Use the cluster-segment address,
# not a VPN or management address, or storage traffic will follow it there.
MGMTD_HOST="10.10.59.196"

# Leading octets of the cluster subnet. Used to work out which NIC on each
# node faces the cluster, so BeeGFS can be pinned to it.
CLUSTER_SUBNET="10.10.59."

# Where the BeeGFS filesystem gets mounted on clients.
BEEGFS_MOUNT="/mnt/beegfs"

# Per-node local paths for the metadata and storage stores.
META_DIR="/var/lib/beegfs/meta"
STORAGE_DIR="/data/beegfs/storage"

# Node lists, short hostnames, space separated.
MGMT_NODES="login"
META_NODES="node1 node2"
STORAGE_NODES="node1 node2 node3 node4"
CLIENT_NODES="login node1 node2 node3 node4"
